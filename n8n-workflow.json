    {
      "parameters": {
        "jsCode": "const text = $json.final_report;\nconst query = $json.query;\nconst mode = $json.mode;\n\nconst modeLabel = mode === 'deep' ? 'Deep Analysis' : 'Quick Analysis';\n\nconst slackText = `*Query:* ${query}\\n*Mode:* ${modeLabel}\\n\\n` + text\n  .replace(/\\*\\*(.*?)\\*\\*/g, '*$1*')       // **bold** → *bold*\n  .replace(/^#{1,6}\\s*(.*)$/gm, '*$1*');   // ## Header → *Header*\n\nreturn [{\n  json: {\n    ...$json,\n    slack_text: slackText\n  }\n}];"
      },
